# Database
CMS_DB_PATH=./data/cms.sqlite

# Listeners
CMS_TCP_PORT=9020        # SMIB firmware mux/JSON protocol (replaces cms_server.py)
CMS_VOUCHER_PORT=8080    # legacy voucher API (replaces voucher-server.js) - must stay 8080
CMS_HTTP_PORT=8090       # staff web app

# Legacy voucher API key (header: x-api-key). Must match the slot game's VOUCHER_API_KEY.
CMS_VOUCHER_API_KEY=ivan1507

# Secret used to sign staff session cookies. CHANGE THIS in production.
CMS_SESSION_SECRET=change-me-in-production

# Loyalty points earned per whole MKD on debit_commit. Integer ratio keeps the
# maths exact: points = floor(amount_deni * pointsPerMkd / 100). 0 disables earning.
CMS_POINTS_PER_MKD=1

# Server-side idle logout for terminal sessions (ms). 5 minutes.
CMS_SESSION_IDLE_MS=300000

# Ticket expiry in days. Empty/unset = never expire (legacy behaviour).
CMS_TICKET_EXPIRY_DAYS=

# IANA zone the venue sits in. The fiscal day ends at midnight HERE: receipt numbers
# restart at 0001 on each local day, while the database itself stays UTC. Skopje is
# UTC+1/+2, so a sale at 23:30 UTC in July is already tomorrow's receipt. An unknown
# zone fails at boot rather than quietly numbering receipts on the wrong day.
CMS_TIME_ZONE=Europe/Skopje

# External fiscal receipt-render service ("испринтај фискална" at the POS).
# Empty/unset = printing fails closed (503) rather than silently no-op.
CMS_RECEIPT_API_URL=https://fiscal-printer-sim.vercel.app
CMS_RECEIPT_API_KEY=

# Header printed on the fiscal receipt: the legal entity and its address. The render
# API substitutes its own demo company for anything we don't send, so leave these
# unset only in development.
CMS_RECEIPT_STORE_NAME=
CMS_RECEIPT_ADDRESS=
